# Copy to deploy/docker/.env (ignored by git), fill in, and keep it readable only by the
# operator: chmod 600 deploy/docker/.env. Never commit the real file.

# Public DNS name of this server. Learners and staff open https://<COURSE_HOSTNAME>.
COURSE_HOSTNAME=course.example.org
# Long random value, letters and digits only (it is part of a database URL):
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional. Ports and the address the proxy listens on.
# COURSE_BIND_ADDRESS=0.0.0.0
# COURSE_HTTP_PORT=80
# COURSE_HTTPS_PORT=443
# Optional Caddy global options, e.g. `local_certs` on a private network, or an ACME email.
# CADDY_GLOBAL_OPTIONS=
# Optional. Change only if 172.30.89.0/24 is already used on this host; keep the proxy
# address inside COURSE_SUBNET and outside COURSE_DYNAMIC_RANGE.
# COURSE_SUBNET=172.30.89.0/24
# COURSE_DYNAMIC_RANGE=172.30.89.128/25
# COURSE_PROXY_ADDRESS=172.30.89.10

# Optional supervision (docker compose --profile supervision ...). The token is a long
# random secret shared by the API and the supervisor: openssl rand -hex 32
# SUPERVISOR_HOST_TOKEN=
# Comma-separated workspace IDs printed by the bootstrap command.
# SUPERVISOR_WORKSPACE_IDS=
# With CADDY_GLOBAL_OPTIONS=local_certs, let the supervisor trust Caddy's own authority:
# COURSE_EXTRA_CA_CERTS=/proxy-ca/root.crt
