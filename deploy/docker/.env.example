# Course Core on Docker: settings for compose.yaml. `deploy/docker/core.sh up` copies this file
# to deploy/docker/.env (ignored by git, owner-only) and fills in the two secrets below with
# long random values. Never commit .env or paste it anywhere.

# Secrets, generated by `core.sh up` when empty. Letters and digits only.
POSTGRES_PASSWORD=
SUPERVISOR_HOST_TOKEN=

# ---- Where people open the course ----------------------------------------------------------
# Public server: its DNS name. Ports 80 and 443 must reach this host; Caddy gets the certificate.
#   COURSE_HOSTNAME=course.example.org
# Private machine (a Mac, a lab box, a tailnet-only server): keep `localhost`, listen on this
# machine only, and reach it through `tailscale serve` (see README.md, "Private and tailnet use").
COURSE_HOSTNAME=localhost
COURSE_BIND_ADDRESS=127.0.0.1
COURSE_HTTP_PORT=8080
COURSE_HTTPS_PORT=8443
# Plain HTTP on 127.0.0.1 only, for `tailscale serve` or another forwarder on this machine.
# COURSE_LOCAL_HTTP_PORT=8380
# Further exact origins browsers may use, comma-separated: https://<machine>.<tailnet>.ts.net,
# or http://<100.x.y.z>:<port> (plain http only for a literal Tailscale address).
# COURSE_ADDITIONAL_ORIGINS=
# Optional Caddy global options, for example `email you@example.org` for the public certificate.
# CADDY_GLOBAL_OPTIONS=

# ---- Course files (code fixture registries, teaching verifiers) ----------------------------
# A host directory, mounted read-only; list the file names to load (comma-separated).
# COURSE_FILES_DIR=./course-files
# COURSE_CODE_FIXTURES=
# COURSE_TEACHING_VERIFIERS=
# Adaptation adapters (JSON list): bounded-numeric-v1, authored-bank-v1, authored-code-bank-v1,
# authored-teaching-bank-v1.
# COURSE_ADAPTATION_ADAPTERS=[]

# ---- Filled in by core.sh ------------------------------------------------------------------
# The workspace(s) the supervisor serves, written by `core.sh bootstrap`.
# SUPERVISOR_WORKSPACE_IDS=
# The Course Core image. Empty: built here from this checkout. A release image:
#   COURSE_CORE_IMAGE=ghcr.io/roeehrl/course-core:v0.1.60   (when releases publish images)
# COURSE_CORE_IMAGE=

# ---- Rarely changed ------------------------------------------------------------------------
# Change only if 172.30.89.0/24 is already used on this host; keep the proxy address inside
# COURSE_SUBNET and outside COURSE_DYNAMIC_RANGE.
# COURSE_SUBNET=172.30.89.0/24
# COURSE_DYNAMIC_RANGE=172.30.89.128/25
# COURSE_PROXY_ADDRESS=172.30.89.10
# Docker socket on the host, if it is not at /var/run/docker.sock.
# COURSE_DOCKER_SOCKET=/var/run/docker.sock
# Sign-in with one-time codes (off by default): AUTH_LOGIN_CODES=enabled
