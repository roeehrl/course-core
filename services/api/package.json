{
  "name": "@course-core/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.qualification.json",
    "test": "vitest run test",
    "test:browser": "playwright test",
    "test:practical": "tsx qualification/practical-flow.ts",
    "test:supervised": "tsx qualification/supervised-flow.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "bootstrap": "tsx src/bootstrap-cli.ts",
    "set-password": "tsx src/set-password-cli.ts",
    "start": "node dist/main.js",
    "check:adapter-digests": "node scripts/check-adapter-digests.mjs"
  },
  "dependencies": {
    "@course-core/adaptation": "file:../../packages/adaptation",
    "@course-core/policy": "file:../../packages/policy",
    "@course-core/providers": "file:../../packages/providers",
    "@course-core/research": "file:../../packages/research",
    "@course-core/sandbox": "file:../../packages/sandbox",
    "@course-core/sdk": "https://github.com/roeehrl/course-sdk/releases/download/v0.5.0/course-core-sdk-0.5.0.tgz",
    "@course-core/supervisor": "file:../supervisor",
    "@course-core/visuals": "file:../../packages/visuals",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "^10.1.6",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "license": "Apache-2.0"
}
