# Required infrastructure settings; example addresses only, no credentials.
SUPERVISOR_TEMPORAL_ADDRESS=127.0.0.1:7233
SUPERVISOR_TEMPORAL_NAMESPACE=default
SUPERVISOR_TEMPORAL_TASK_QUEUE=course-supervisor-v1
SUPERVISOR_TEMPORAL_TLS=false
# SUPERVISOR_TEMPORAL_API_KEY=
SUPERVISOR_HOST_URL=http://127.0.0.1:8080/
SUPERVISOR_HOST_TOKEN=
SUPERVISOR_ACTIVITY_CONCURRENCY=4

# Optional: when absent, jobs visibly wait for configuration.
# Both must be supplied together. No provider is configured by this example.
# SUPERVISOR_PROVIDER_URL=https://gateway.example.invalid/
# SUPERVISOR_PROVIDER_TOKEN=
